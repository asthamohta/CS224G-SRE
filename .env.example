# GitHub Ingestion Configuration
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (needs repo read permissions)
GITHUB_TOKEN=your_github_token_here

# GitHub Webhook Secret (for webhook signature verification)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Repository to watch
WATCH_REPO_OWNER=asthamohta
WATCH_REPO_NAME=CS224G-SRE

# Path prefix to filter changes (e.g., "services/cart" or leave empty for all)
WATCH_PATH_PREFIX=

# Service ID to use for ingested events (derived from path if not set)
SERVICE_ID=

# IMPORTANT: Path where GitHub PR/commit events will be saved as JSONL
# This file will be read by the graph/agent.py for context enrichment
GITHUB_OUTPUT_PATH=./github_events.jsonl

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# Choose your LLM provider: gemini, openai, anthropic
LLM_PROVIDER=gemini

# Gemini API Key (Google AI Studio - free tier available)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (ChatGPT, GPT-4, GPT-4-turbo)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

# Anthropic API Key (Claude 3 Opus, Sonnet, Haiku)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================================

# OTLP (OpenTelemetry) Integration
# Set to true to enable real-time graph construction from OTLP traces/metrics/logs
# When enabled, the ingestion service will build a live service dependency graph
# Access the graph state at: http://localhost:8000/graph/status
ENABLE_GRAPH_BUILDER=true

# Slack Integration
SLACK_BOT_TOKEN=your_token_here 
SLACK_SIGNING_SECRET=your_signing_secret_here
# incident 
SLACK_ALERT_CHANNEL=
SLACK_RCA_CHANNEL=
# minimum seconds between repeated alerts for the same service (default 5 min)
SLACK_ALERT_COOLDOWN_SECONDS=300
# Slack Integration (for automatic RCA notifications)
# Set to true to enable Slack notifications when RCA analysis completes
SLACK_ENABLED=true

# Slack Webhook URL - Get this from: https://api.slack.com/messaging/webhooks
# 1. Go to https://api.slack.com/apps
# 2. Create a new app or select existing app
# 3. Enable "Incoming Webhooks" feature
# 4. Add webhook to workspace and select channel
# 5. Copy the webhook URL here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Server Configuration
HOST=0.0.0.0
PORT=8000
